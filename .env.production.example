# API Configuration
NODE_ENV=production
API_PORT=3001
API_KEY_SECRET=insira_um_segredo_aleatorio_e_seguro_aqui

# PostgreSQL Database Configuration
POSTGRES_USER=electoral_user
POSTGRES_PASSWORD=insira_uma_senha_do_banco_segura_aqui
POSTGRES_DB=insystens_electoral

# Prisma Database Access URL (Runtime com pooler se aplicável)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@electoral-postgres:5432/${POSTGRES_DB}?schema=public
# Prisma Direct Access URL (Conexão direta para migrations DDL)
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@electoral-postgres:5432/${POSTGRES_DB}?schema=public

# Redis Cache Configuration
REDIS_URL=redis://electoral-redis:6379

# Production Security & HTTP Access Configuration
# CORS_ORIGIN: Lista restrita de domínios autorizados (ex: "https://mandatopro.com.br,https://app.mandatopro.com.br")
CORS_ORIGIN=https://mandatopro.com.br,https://app.mandatopro.com.br
# ADMIN_MASTER_KEY: Segredo de alta entropia para rotas administrativas (mínimo: 32 caracteres criptográficos)
ADMIN_MASTER_KEY=insira_uma_chave_mestra_administrativa_longa_e_segura_aqui

# Proxy Configuration (Fastify trustProxy)
# Padrão seguro: false (ignora cabeçalhos X-Forwarded-* forjados)
# Se atrás de 1 proxy reverso verificado (Cloudflare / Traefik / ALB / EasyPanel): configure TRUST_PROXY=1
# Se subredes confiáveis específicas: configure TRUST_PROXY=127.0.0.1,10.0.0.0/8
# NUNCA use 'true' irrestrito se clientes puderem acessar a aplicação sem passar pelo proxy
TRUST_PROXY=false

# Production Rate Limiting Configuration (limites por minuto)
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_ADMIN_MAX=20
RATE_LIMIT_IMPORT_MAX=5
RATE_LIMIT_TENANT_MAX=60
