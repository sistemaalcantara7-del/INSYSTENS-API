datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["tse", "mandato", "analytics", "public"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

// ==========================================
// SCHEMA: public
// ==========================================

model ImportJob {
  id               String        @id @default(uuid())
  status           String        // Ex: "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  filename         String
  fileType         String        // Ex: "CANDIDATOS", "VOTOS_SECAO"
  totalRecords     Int           @default(0)
  processedRecords Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  errors           ImportError[]

  @@schema("public")
}

model ImportError {
  id           String    @id @default(uuid())
  importJobId  String
  importJob    ImportJob @relation(fields: [importJobId], references: [id])
  rowNumber    Int
  errorDetails String
  rawData      String?
  createdAt    DateTime  @default(now())

  @@schema("public")
}

model ApiKey {
  id         String   @id @default(uuid())
  clientName String
  keyHash    String   @unique
  isActive   Boolean  @default(true)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("public")
}

model Account {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  type              String             // Ex: "PARLAMENTAR", "PARTIDO", "CONSULTORIA"
  isActive          Boolean            @default(true)
  ssoId             String?            @unique // Para futura integração SSO com MandatoPro
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  apiKeys           ApiKey[]
  politicalProfile  PoliticalProfile?
  electionInterests ElectionInterest[]
  automaticFilters  AutomaticFilter[]

  @@schema("public")
}

model PoliticalProfile {
  id              String     @id @default(uuid())
  accountId       String     @unique
  account         Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  candidateName   String?
  candidateNumber String?
  role            String?    // Ex: "DEPUTADO_FEDERAL", "VEREADOR"
  party           String?
  uf              String?
  cityCode        Int?
  candidateId     String?    // Vinculo futuro com dados oficiais do TSE
  candidate       Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@schema("public")
}

model ElectionInterest {
  id         String    @id @default(uuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  electionId String?
  election   Election? @relation(fields: [electionId], references: [id], onDelete: SetNull)
  year       Int
  round      Int
  type       String    // Ex: "FEDERAL", "MUNICIPAL"
  createdAt  DateTime  @default(now())

  @@unique([accountId, year, round, type])
  @@schema("public")
}

model AutomaticFilter {
  id         String   @id @default(uuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filterType String   // Ex: "GEOGRAPHIC", "DEMOGRAPHIC"
  field      String   // Ex: "uf", "cityCode"
  operator   String   // Ex: "EQUALS", "IN"
  value      String   // Valor em formato string (ex: "SP" ou ["SP"])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("public")
}

// ==========================================
// SCHEMA: tse
// ==========================================

model State {
  uf        String @id
  name      String
  cities    City[]

  @@schema("tse")
}

model City {
  code             Int                @id
  name             String
  uf               String
  state            State              @relation(fields: [uf], references: [uf])
  zones            ElectoralZone[]
  pollingLocations PollingLocation[]

  @@schema("tse")
}

model ElectoralZone {
  id               String            @id @default(uuid())
  zoneNumber       Int
  cityCode         Int
  city             City              @relation(fields: [cityCode], references: [code])
  pollingLocations PollingLocation[]

  @@unique([zoneNumber, cityCode])
  @@schema("tse")
}

model Election {
  id                         String                       @id @default(uuid())
  year                       Int
  round                      Int
  type                       String                       // Ex: "FEDERAL", "MUNICIPAL"
  description                String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  candidates                 Candidate[]
  sectionVotes               SectionVote[]
  performanceByCity          PerformanceByCity[]
  performanceByLocation      PerformanceByPollingLocation[]
  performanceBySection       PerformanceBySection[]
  electionInterests          ElectionInterest[]

  @@unique([year, round, type])
  @@index([year])
  @@schema("tse")
}

model Candidate {
  id                         String                       @id @default(uuid())
  electionId                 String
  election                   Election                     @relation(fields: [electionId], references: [id])
  electoralNumber            String
  candidateName              String
  urnName                    String
  role                       String                       // Ex: "PREFEITO", "VEREADOR"
  officeCode                 Int?
  officeName                 String?
  uf                         String                       // Sigla do estado (ex: "SP")
  partyName                  String
  partyNumber                Int
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  sectionVotes               SectionVote[]
  performanceByCity          PerformanceByCity[]
  performanceByLocation      PerformanceByPollingLocation[]
  performanceBySection       PerformanceBySection[]
  politicalProfiles          PoliticalProfile[]

  @@unique([electionId, electoralNumber, role])
  @@index([uf])
  @@index([electionId])
  @@schema("tse")
}

model PollingLocation {
  id                    String                         @id @default(uuid())
  uf                    String
  cityCode              Int
  city                  City                           @relation(fields: [cityCode], references: [code])
  zoneNumber            Int
  locationCode          Int                            // Código do local de votação
  name                  String
  address               String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  sections              ElectoralSection[]
  performanceByLocation PerformanceByPollingLocation[]
  electoralZoneId       String?
  electoralZone         ElectoralZone?                 @relation(fields: [electoralZoneId], references: [id])

  @@unique([uf, cityCode, zoneNumber, locationCode])
  @@index([uf])
  @@index([cityCode])
  @@index([zoneNumber])
  @@schema("tse")
}

model ElectoralSection {
  id                   String                 @id @default(uuid())
  pollingLocationId    String
  pollingLocation      PollingLocation        @relation(fields: [pollingLocationId], references: [id])
  uf                   String
  cityName             String
  zoneNumber           Int
  sectionNumber        Int                    // Número da seção eleitoral
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  sectionVotes         SectionVote[]
  performanceBySection PerformanceBySection[]

  @@unique([uf, cityName, zoneNumber, sectionNumber])
  @@index([uf])
  @@index([cityName])
  @@index([zoneNumber])
  @@index([sectionNumber])
  @@schema("tse")
}

model SectionVote {
  id                 String           @id @default(uuid())
  electionId         String
  election           Election         @relation(fields: [electionId], references: [id])
  candidateId        String?
  candidate          Candidate?       @relation(fields: [candidateId], references: [id])
  electoralSectionId String
  electoralSection   ElectoralSection @relation(fields: [electoralSectionId], references: [id])
  votesCount         Int
  officeCode         Int
  officeName         String
  votableTypeCode    Int?
  votableType        String           // Ex: "NOMINAL", "LEGENDA", "BRANCO", "NULO", "ANULADO"
  votableNumber      String?
  votableName        String?
  partyNumber        Int?
  partyAcronym       String?
  partyName          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([electionId, electoralSectionId, officeCode, votableType, votableNumber])
  @@index([electionId, officeCode])
  @@index([electionId, candidateId])
  @@index([electionId, officeCode, votableType])
  @@index([electionId, officeCode, votableNumber])
  @@schema("tse")
}

model SectionElectorateProfile {
  id                    String   @id @default(uuid())
  electionYear          Int
  uf                    String
  cityCode              Int
  cityName              String
  zoneNumber            Int
  sectionNumber         Int
  pollingLocationCode   Int
  genderCode            Int?
  gender                String?
  ageRangeCode          String?
  ageRange              String?
  educationCode         Int?
  education             String?
  raceCode              Int?
  race                  String?
  maritalStatusCode     Int?
  maritalStatus         String?
  voteObligationType    String?
  votersCount           Int
  biometricVotersCount  Int
  disabledVotersCount   Int
  socialNameVotersCount Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([uf, cityName])
  @@index([zoneNumber, sectionNumber])
  @@index([electionYear])
  @@schema("tse")
}

// ==========================================
// SCHEMA: mandato
// ==========================================

model Leader {
  id            String          @id @default(uuid())
  tenantId      String          // Isolamento MANDATOPRO
  name          String
  phone         String?
  email         String?
  region        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  voters        RegisteredVoter[]
  campaignEvents CampaignEvent[]

  @@index([tenantId])
  @@schema("mandato")
}

model RegisteredVoter {
  id            String          @id @default(uuid())
  tenantId      String
  name          String
  document      String?
  phone         String?
  email         String?
  uf            String
  cityCode      Int
  zoneNumber    Int?
  sectionNumber Int?
  address       String?
  neighborhood  String?
  latitude      Float?
  longitude     Float?
  leaderId      String?
  leader        Leader?         @relation(fields: [leaderId], references: [id])
  demands       CitizenDemand[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId])
  @@index([uf, cityCode])
  @@index([leaderId])
  @@index([latitude, longitude])
  @@schema("mandato")
}

model SocialAction {
  id               String            @id @default(uuid())
  tenantId         String
  title            String
  description      String?
  date             DateTime
  address          String?
  latitude         Float?
  longitude        Float?
  status           String            // Ex: "PENDING", "COMPLETED", "CANCELLED"
  servicesProvided ServiceProvided[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId])
  @@index([latitude, longitude])
  @@schema("mandato")
}

model ServiceProvided {
  id             String       @id @default(uuid())
  tenantId       String
  citizenName    String
  description    String
  cost           Decimal?     @db.Decimal(10, 2)
  date           DateTime
  status         String
  socialActionId String?
  socialAction   SocialAction? @relation(fields: [socialActionId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId])
  @@schema("mandato")
}

model CitizenDemand {
  id              String          @id @default(uuid())
  tenantId        String
  title           String
  description     String
  category        String?
  status          String
  priority        String          // Ex: "LOW", "MEDIUM", "HIGH"
  voterId         String
  voter           RegisteredVoter @relation(fields: [voterId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId])
  @@index([voterId])
  @@schema("mandato")
}

model Campaign {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  year           Int
  targetGoal     String?
  budget         Decimal?        @db.Decimal(12, 2)
  events         CampaignEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId])
  @@schema("mandato")
}

model CampaignEvent {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  title       String
  description String?
  date        DateTime
  address     String?
  latitude    Float?
  longitude   Float?
  leaderId    String?
  leader      Leader?   @relation(fields: [leaderId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([campaignId])
  @@index([leaderId])
  @@index([latitude, longitude])
  @@schema("mandato")
}

// ==========================================
// SCHEMA: analytics
// ==========================================

model TerritorialScore {
  id            String   @id @default(uuid())
  tenantId      String
  uf            String
  cityCode      Int
  zoneNumber    Int?
  sectionNumber Int?
  score         Float    // Peso de desempenho/influência territorial
  rank          Int?
  explanation   String?
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([uf, cityCode])
  @@schema("analytics")
}

model PerformanceByCity {
  id             String    @id @default(uuid())
  tenantId       String
  electionId     String
  election       Election  @relation(fields: [electionId], references: [id])
  cityCode       Int
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id])
  totalVotes     Int
  votePercentage Float
  candidateRank  Int?
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([electionId, cityCode])
  @@index([candidateId])
  @@schema("analytics")
}

model PerformanceByPollingLocation {
  id                String          @id @default(uuid())
  tenantId          String
  electionId        String
  election          Election        @relation(fields: [electionId], references: [id])
  pollingLocationId String
  pollingLocation   PollingLocation @relation(fields: [pollingLocationId], references: [id])
  candidateId       String
  candidate         Candidate       @relation(fields: [candidateId], references: [id])
  totalVotes        Int
  votePercentage    Float
  candidateRank     Int?
  updatedAt         DateTime        @updatedAt

  @@index([tenantId])
  @@index([electionId, pollingLocationId])
  @@index([candidateId])
  @@schema("analytics")
}

model PerformanceBySection {
  id                 String           @id @default(uuid())
  tenantId           String
  electionId         String
  election           Election         @relation(fields: [electionId], references: [id])
  electoralSectionId String
  electoralSection   ElectoralSection @relation(fields: [electoralSectionId], references: [id])
  candidateId        String
  candidate          Candidate        @relation(fields: [candidateId], references: [id])
  totalVotes         Int
  votePercentage     Float
  updatedAt          DateTime         @updatedAt

  @@index([tenantId])
  @@index([electionId, electoralSectionId])
  @@index([candidateId])
  @@schema("analytics")
}

model GrowthOpportunity {
  id                 String  @id @default(uuid())
  tenantId           String
  cityCode           Int
  zoneNumber         Int?
  pollingLocationId  String?
  priorityScore      Float
  targetAudienceSize Int
  notes              String?
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([cityCode])
  @@schema("analytics")
}

model HeatmapPoint {
  id          String   @id @default(uuid())
  tenantId    String
  cityCode    Int
  zoneNumber  Int?
  latitude    Float
  longitude   Float
  weight      Float
  metricType  String   // Ex: "VOTES", "DEMANDS", "LEADERS", "VOTERS"
  sourceType  String   // Ex: "TSE", "MANDATOPRO"
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([cityCode])
  @@index([latitude, longitude])
  @@schema("analytics")
}

model AiStrategyReport {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  prompt          String   @db.Text
  context         String   @db.Text
  response        String   @db.Text
  priorityScore   Float?
  recommendations String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@schema("analytics")
}

model StrategicRecord {
  tenantId  String   @default("default")
  id        String
  entity    String
  source    String
  data      Json
  metadata  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenantId, id])
  @@index([tenantId])
  @@index([entity])
  @@index([source])
  @@schema("analytics")
}

model GraphNodeRecord {
  tenantId   String   @default("default")
  id         String
  type       String
  properties Json
  metadata   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outgoingEdges GraphEdgeRecord[] @relation("FromNode")
  incomingEdges GraphEdgeRecord[] @relation("ToNode")

  @@id([tenantId, id])
  @@index([tenantId])
  @@index([type])
  @@schema("analytics")
}

model GraphEdgeRecord {
  tenantId  String   @default("default")
  id        String
  from      String
  to        String
  relation  String
  weight    Float    @default(1.0)
  metadata  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromNode GraphNodeRecord @relation("FromNode", fields: [tenantId, from], references: [tenantId, id], onDelete: Cascade)
  toNode   GraphNodeRecord @relation("ToNode", fields: [tenantId, to], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, from])
  @@index([tenantId, to])
  @@index([relation])
  @@schema("analytics")
}

model StrategicSignalRecord {
  tenantId   String   @default("default")
  id         String
  type       String
  severity   String
  confidence Float    @default(1.0)
  context    Json
  reason     String   @db.Text
  metadata   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, severity])
  @@schema("analytics")
}

model DecisionRecord {
  tenantId           String
  id                 String
  category           String
  priority           String
  title              String
  summary            String   @db.Text
  expectedImpact     String   @db.Text
  confidence         Float    @default(1.0)
  reasons            Json
  recommendedActions Json
  relatedSignals     Json
  metadata           Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@id([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, priority])
  @@schema("analytics")
}

model DecisionAuditEventRecord {
  id               String   @default(uuid())
  tenantId         String
  actorId          String
  actorType        String
  decisionId       String
  operation        String
  result           String
  reason           String?  @db.Text
  source           String   @default("system")
  decisionCategory String?
  decisionPriority String?
  relatedSignals   Json?
  details          Json?
  timestamp        DateTime @default(now())

  @@id([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, decisionId])
  @@index([tenantId, actorId])
  @@index([tenantId, operation])
  @@schema("analytics")
}

model ActionProposalRecord {
  tenantId       String
  id             String
  decisionId     String
  category       String
  priority       String
  title          String
  description    String   @db.Text
  expectedImpact String   @db.Text
  estimatedGain  Float    @default(0)
  timeframe      String
  status         String   @default("PROPOSED")
  metadata       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, decisionId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@schema("analytics")
}

model ActionExecutionRecord {
  tenantId      String
  id            String
  proposalId    String
  decisionId    String
  attemptNumber Int      @default(1)
  status        String   @default("PENDING")
  mode          String   @default("SIMULATED")
  executedBy    Json
  result        Json?
  error         String?  @db.Text
  dispatchedAt  DateTime?
  completedAt   DateTime?
  metadata      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([tenantId, id])
  @@unique([tenantId, proposalId, attemptNumber])
  @@index([tenantId])
  @@index([tenantId, proposalId])
  @@index([tenantId, status])
  @@schema("analytics")
}


