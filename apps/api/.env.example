# API Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
# DATABASE_URL: Usada pelo PrismaClient em runtime (suporta connection poolers como Supavisor porta 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electoral_db?schema=public"
# DIRECT_URL: Usada pelo Prisma CLI para migrations e DDL (porta direta 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/electoral_db?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Security & HTTP Access Configuration
# CORS_ORIGIN: Lista de origens permitidas separadas por vírgula (nunca use '*' com credenciais em produção)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
# ADMIN_MASTER_KEY: Segredo obrigatório para acesso a /api/v1/admin/* (mínimo recomendado: 32 caracteres aleatórios)
ADMIN_MASTER_KEY="insira_sua_chave_mestra_administrativa_aqui"

# Proxy Configuration (Fastify trustProxy)
# Padrão seguro: false. Em produção atrás de proxy único, use: TRUST_PROXY="1"
TRUST_PROXY="false"

# Rate Limiting Configuration (limites por minuto)
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_ADMIN_MAX=20
RATE_LIMIT_IMPORT_MAX=5
RATE_LIMIT_TENANT_MAX=60
